<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/exploreItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:elevation="2dp"
    android:padding="9dp"
    android:layout_marginBottom="10dp">
    <ImageView
        android:id="@+id/exploreItemImage"
        android:layout_width="136dp"
        android:layout_height="142dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/photo_bicycle"
        android:background="@drawable/bg_photo_slot"
        android:clipToOutline="true"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="142dp"
        android:layout_weight="1"
        android:paddingStart="11dp"
        android:paddingTop="12dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/exploreItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/rota_navy"
            android:textStyle="bold"
            tools:text="Bicicleta en buen estado"
            android:maxLines="2"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/exploreItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/rota_dark_green"
            tools:text="Disponible"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_pale_green"/>
        <TextView
            android:id="@+id/exploreItemDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/rota_gray"
            tools:text="Bicicleta todo terreno, funciona muy bien. Solo detalles de uso normales. Ideal para paseos, ejercicio o transporte."
            android:layout_marginTop="8dp"
            android:maxLines="3"
            android:ellipsize="end"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="7dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_rota_pin"
                android:contentDescription="@null"/>
            <TextView
                android:id="@+id/exploreItemLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textColor="@color/rota_gray"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Barranca, Puntarenas"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
