
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFBFD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="17dp"
            android:paddingBottom="11dp">

            <ImageView
                android:id="@+id/actionBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="3dp"
                android:src="@drawable/ic_rota_back"
                android:contentDescription="@string/TextBack"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/myItemsHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/TextMyItems"
                    android:textColor="@color/rota_navy"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/headerSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/TextManagePublications"
                    android:textColor="@color/rota_gray"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/myItemsSearchBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/inputSearchMyItems"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:hint="@string/rota_search_publication_hint"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/rota_navy"
                    android:textColorHint="@color/rota_gray"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/actionCloseSearch"
                    android:layout_width="36dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="5dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_rota_close"
                    android:tint="@color/rota_navy"
                    android:contentDescription="@string/TextClose"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <ImageView
                android:id="@+id/actionSearchMyItems"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:padding="5dp"
                android:src="@drawable/ic_rota_search"
                android:contentDescription="@string/TextSearch"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/itemFilters0"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_pill_on"
                android:gravity="center"
                android:text="@string/TextAllPublications"
                android:textColor="@color/rota_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/itemFilters1"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="@string/rota_available_plural"
                android:textColor="@color/rota_gray"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/itemFilters2"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="@string/rota_reserved_plural"
                android:textColor="@color/rota_gray"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/myItemsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            tools:listitem="@layout/view_my_item"
            tools:itemCount="3" />

        <TextView
            android:id="@+id/myItemsEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/TextNoItems"
            android:textColor="@color/rota_gray"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

</LinearLayout>
