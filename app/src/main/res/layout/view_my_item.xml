<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/myItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="11dp"
    android:padding="10dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageView
        android:id="@+id/myItemImage"
        android:layout_width="143dp"
        android:layout_height="143dp"
        android:background="@drawable/bg_photo_slot"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        tools:src="@drawable/photo_bicycle"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="143dp"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/myItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/rota_navy"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Bicicleta en buen estado"/>
        <TextView
            android:id="@+id/myItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/bg_pale_green"
            android:textSize="11sp"
            android:textColor="@color/rota_dark_green"
            tools:text="Disponible"/>
        <TextView
            android:id="@+id/myItemDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="11sp"
            android:textColor="@color/rota_gray"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="Bicicleta todo terreno, funciona muy bien. Solo detalles de uso normales."/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_rota_pin"
                android:tint="@color/rota_gray"
                android:contentDescription="@null"/>
            <TextView
                android:id="@+id/myItemLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="10sp"
                android:textColor="@color/rota_gray"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Barranca, Puntarenas"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/bg_divider"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_rota_edit"
                    android:tint="@color/rota_gray"
                    android:contentDescription="@null"/>
                <TextView
                    android:id="@+id/myItemEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:text="@string/TextEdit"
                    android:textSize="11sp"
                    android:textColor="@color/rota_gray"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_divider"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_rota_trash"
                    android:tint="@color/rota_red"
                    android:contentDescription="@null"/>
                <TextView
                    android:id="@+id/myItemDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:text="@string/TextDelete"
                    android:textSize="11sp"
                    android:textColor="@color/rota_red"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
